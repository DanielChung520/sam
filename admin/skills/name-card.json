    {
      "id": "knowledge-base",
      "title": "知識庫檢索",
      "desc": "向量化查詢 → Qdrant 語意搜尋 → LLM 生成含來源回覆。當 Agent 判斷需要查資訊時調用此技能。",
      "color": "#10b981",
      "tag": "RAG",
      "date": "2026-07-29",
      "icon": "menu_book",
      "flow": {
        "nodes": [
          {
            "id": "kb-1",
            "type": "trigger",
            "label": "接收查詢",
            "desc": "從 Agent 接收需要查知識庫的文字查詢",
            "color": "#6366f1",
            "enabled": true,
            "config": {
              "source": "Agent 工具調用"
            }
          },
          {
            "id": "kb-2",
            "type": "function",
            "label": "向量化查詢",
            "desc": "呼叫 embedding model 將查詢文字轉為向量",
            "color": "#22c55e",
            "enabled": true,
            "config": {
              "code": "// const embedding = await embed(query)",
              "timeout": 3000
            }
          },
          {
            "id": "kb-3",
            "type": "storage",
            "label": "Qdrant 向量搜尋",
            "desc": "以 query vector 在 Qdrant collection 中檢索 topK 相似片段",
            "color": "#3b82f6",
            "enabled": true,
            "config": {
              "collection": "knowledge_base",
              "topK": 5,
              "scoreThreshold": 0.7
            }
          },
          {
            "id": "kb-4",
            "type": "condition",
            "label": "檢索結果檢驗",
            "desc": "確認是否有分數超過門檻的有效結果",
            "color": "#eab308",
            "enabled": true,
            "config": {
              "expression": "results.length > 0 && results[0].score >= 0.7",
              "outputs": [
                "有結果",
                "無結果"
              ]
            }
          },
          {
            "id": "kb-5",
            "type": "function",
            "label": "組裝 Context",
            "desc": "將檢索到的片段依關聯度排序，組裝成 LLM context",
            "color": "#22c55e",
            "enabled": true,
            "config": {
              "code": "// const context = assembleContext(results, maxChars=4000)",
              "timeout": 1000
            }
          },
          {
            "id": "kb-6",
            "type": "llm",
            "label": "生成含來源回答",
            "desc": "LLM 根據 context 生成回答，須標註資料來源",
            "color": "#f97316",
            "enabled": true,
            "config": {
              "model": "dllm 預設",
              "temperature": 0.3,
              "maxTokens": 1024,
              "systemPrompt": "你是一個知識庫助手。請根據提供的參考資料回答用戶問題。必須標註資料來源。若資料不足以回答，請明確說不知道。",
              "userPrompt": "參考資料：{context}\n\n用戶問題：{query}\n\n請根據上述資料回答，並標註每段資訊的來源。"
            }
          },
          {
            "id": "kb-7",
            "type": "reply",
            "label": "回覆查詢結果",
            "desc": "將 LLM 生成的回答傳回 Agent",
            "color": "#06b6d4",
            "enabled": true,
            "config": {
              "template": "{kb_response}"
            }
          },
          {
            "id": "kb-8",
            "type": "reply",
            "label": "回覆無結果",
            "desc": "向量搜尋無匹配時，回覆未找到相關資料",
            "color": "#06b6d4",
            "enabled": true,
            "config": {
              "template": "抱歉，知識庫中未找到與此問題相關的資料。請嘗試換個方式描述，或聯繫客服取得協助。"
            }
          }
        ],
