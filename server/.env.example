# sam server environment variables (example)

# ─── Server ────────────────────────────────────────────────
PORT=9091
NODE_ENV=development

# ─── Database (ArangoDB) ──────────────────────────────────
ARANGO_URL=http://localhost:8529
ARANGO_DB=sam
ARANGO_USER=
ARANGO_PASSWORD=

# ─── JWT Auth ─────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ─── LINE Bot ─────────────────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ─── Taskforge (sub-agent engine) ────────────────────────
TASKFORGE_BASE_URL=http://localhost:9900

# ─── LLM (dllm) ───────────────────────────────────────────
# Leave empty to read from ~/.dllm/config.json automatically
LLM_API_KEY=
LLM_API_BASE=https://dllm.aiconn.ai
LLM_MODEL=Qwythos-9B-Claude-Mythos-5-1M

# ─── Agent State (Redis) ──────────────────────────────────
# Ephemeral conversation state, TTL 30 min default
REDIS_URL=redis://localhost:6379/0
AGENT_TTL_SECONDS=1800
AGENT_HISTORY_LIMIT=20
# 對外公開網域（LINE 分享連結用，production 必須設定）
PUBLIC_BASE_URL=https://la.aiconn.ai

# ─── LLM / VL 模型來源（三層：skill flow config > 此處 env > 內建默認）────────
# 預設為本地 dllm。若要改用雲端模型（如 OpenAI 相容 API），只需：
#   1. 在 skill 流程編輯器的 LLM 節點屬性設定 apiBase/apiKey/model
#   2. 或在此設定以下環境變數（全局默認）
# LLM_API_BASE=http://localhost:11400/v1   # 本地 dllm；雲端例：https://api.openai.com/v1
# LLM_API_KEY=                             # dllm key；雲端例：sk-xxx
# LLM_MODEL=Qwen3-8B-AWQ                   # 文字模型
# VL_MODEL=Qwen2.5-VL-7B-Instruct          # 視覺模型
